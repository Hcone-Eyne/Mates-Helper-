# Copy to .env and fill in. Never commit your real .env.

# --- Required ---
# Token for protected Brain / File Manager endpoints (sent as X-API-Token header).
FOX_API_TOKEN=change-me

# --- LLM providers (set the ones you use) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=

# --- Local Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_STRICT_MODEL=

# --- Data paths (docker-compose sets these to /data/...) ---
FOX_VAULT_ROOT=
FOX_DB_PATH=
FOX_PREFS_PATH=
FOX_TASK_DB_PATH=

# --- Networking (defaults are fine for local use) ---
AGENT_HOST=agent
AGENT_PORT=9000
AGENT_GATEWAY_HOST=127.0.0.1
AGENT_GATEWAY_PORT=8765
PROXY_HOST=mitm-proxy
PROXY_PORT=8080

# --- Limits ---
FOX_HISTORY_MAX_MESSAGES=
FOX_FINANCE_HISTORY_MAX_ENTRIES=

# --- Tests ---
# Set to 1 to run the live-LLM stress harness under pytest.
RUN_STRESS_TESTS=0
